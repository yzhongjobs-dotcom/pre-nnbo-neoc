      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>Robot Safety; Physical Human-Robot Interaction; Compliance and Impedance Control</pdf:Keywords>
